<div class="error-container">
  <div class="card card-error">
    <div class="error-icon-wrapper">
      <i class="fa-solid fa-triangle-exclamation error-big-icon"></i>
    </div>
    
    <h1 class="error-header">{{title}}</h1>
    
    {{#if errorCode}}
      <span class="badge badge-error-code">Mã Lỗi: {{errorCode}}</span>
    {{/if}}

    <div class="error-body">
      <p class="error-main-message">{{message}}</p>
      
      {{#if details}}
        <div class="error-details-box">
          <strong>Chi tiết lỗi kỹ thuật / Nguyên nhân:</strong>
          <pre>{{details}}</pre>
        </div>
      {{/if}}
    </div>

    <div class="error-footer-actions">
      <a href="/books/create" class="btn btn-primary">
        <i class="fa-solid fa-rotate-left"></i> Thử Nhập Lại (Tiền tố {{studentInfo.last3Digits}})
      </a>
      <a href="/" class="btn btn-secondary">
        <i class="fa-solid fa-house"></i> Về Trang Chủ
      </a>
    </div>
  </div>
</div>
